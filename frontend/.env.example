# ASTRAVIGIL Environment Variables Template
# Orbital Risk Engine (FastAPI microservice on port 8000)
VITE_ORBITAL_API_URL=http://localhost:8000

# Mission Intelligence Service (FastAPI microservice on port 8001)
VITE_MISSION_API_URL=http://localhost:8001

# Force mock mode override ('true' forces local offline mock fixtures, 'false' enables live microservices)
VITE_USE_MOCK=false
