# ASTRAVIGIL Orbital Risk Engine - Environment Configuration Example
# Copy to .env and configure as needed.

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CelesTrak Configuration
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CACHE_EXPIRATION_HOURS=4

# Optional Space-Track Credentials (Optional fallback, leave blank if not using)
SPACETRACK_USER=your_spacetrack_username_here
SPACETRACK_PASSWORD=your_spacetrack_password_here
