# ASTRAVIGIL Mission Intelligence — Environment Variables Template
# Copy to .env (git-ignored) for local overrides. Never commit real API keys.

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Optional LLM configuration for POST /api/mission/satellites/{noradId}/briefing
# If LLM_API_KEY is empty or missing, the API automatically uses the deterministic rule_based generator.
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
