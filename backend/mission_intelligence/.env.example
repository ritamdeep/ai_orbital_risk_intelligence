# ASTRAVIGIL Mission Intelligence — Environment Variables Template
# Copy this file to .env (git-ignored) and fill in your key ONLY if enabling live LLM advisories.
# Without an API key, ASTRAVIGIL automatically uses its deterministic fallback advisory generator.

# Provider mode: auto | gemini | openai | fallback
ASTRAVIGIL_LLM_PROVIDER=auto

# Optional generic placeholder
LLM_API_KEY=

# Option 1: Google Gemini API
GEMINI_API_KEY=
ASTRAVIGIL_GEMINI_MODEL=gemini-2.0-flash

# Option 2: OpenAI-compatible API
OPENAI_API_KEY=
ASTRAVIGIL_OPENAI_MODEL=gpt-4o-mini
ASTRAVIGIL_OPENAI_BASE_URL=https://api.openai.com/v1
